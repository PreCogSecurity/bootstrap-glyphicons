# Environment for the local Docker preview (`docker compose up --build`).
#
# Copy this file to `.env` and edit as needed:
#
#     cp .env.example .env
#
# `.env` is git-ignored. This preview serves static files and needs no
# credentials, so keep secrets out of it; the values below are ports and
# bind addresses only.

# Host interface the preview binds to.
#
# The default, 127.0.0.1, keeps the unauthenticated static file server off
# every network interface of your machine. Set it to 0.0.0.0 only when you
# deliberately want other hosts on your network to reach it.
BIND_ADDRESS=127.0.0.1

# Host port published for the preview.
PORT=8080
