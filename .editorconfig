# EditorConfig keeps indentation and line endings consistent across the many
# contributors this project has had since 2012. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Generated or vendored files are not ours to reformat.
[package-lock.json]
insert_final_newline = false
trim_trailing_whitespace = false

[css/*.css]
indent_size = 2

[glyphicons.png]
insert_final_newline = false
trim_trailing_whitespace = false
